<?xml version="1.0" encoding="utf-8"?>
<!-- En la WiFi de casa la PC se contacta por http://IP:47654 (red local). Por internet se usa https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
